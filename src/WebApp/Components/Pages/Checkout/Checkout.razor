@page "/checkout"
@using System.Globalization
@using System.ComponentModel.DataAnnotations
@using Microsoft.Extensions.Options
@using Microsoft.JSInterop
@using eShop.WebApp
@inject BasketState Basket
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IOptions<PayPalOptions> PayPalOptionsAccessor
@attribute [Authorize]
@implements IAsyncDisposable

<PageTitle>Checkout | AdventureWorks</PageTitle>
<SectionContent SectionName="page-header-title">Checkout</SectionContent>

<div class='checkout'>
    <EditForm EditContext="@editContext" FormName="checkout" OnSubmit="@HandleSubmitAsync" Enhance>
        <DataAnnotationsValidator />
        <div class="form">
            <div class="form-section">
                <h2>Shipping address</h2>
                <label>
                    Address
                    <InputText @bind-Value="@Info.Street" />
                    <ValidationMessage For="@(() => Info.Street)" />
                </label>
                <div class="form-group">
                    <div class="form-group-item">
                        <label>
                            City
                            <InputText @bind-Value="@Info.City" />
                            <ValidationMessage For="@(() => Info.City)" />
                        </label>
                    </div>
                    <div class="form-group-item">
                        <label>
                            State
                            <InputText @bind-Value="@Info.State" />
                            <ValidationMessage For="@(() => Info.State)" />
                        </label>
                    </div>
                    <div class="form-group-item">
                        <label>
                            Zip code
                            <InputText @bind-Value="@Info.ZipCode" />
                            <ValidationMessage For="@(() => Info.ZipCode)" />
                        </label>
                    </div>
                </div>
                <div>
                    <label>
                        Country
                        <InputText @bind-Value="@Info.Country" />
                        <ValidationMessage For="@(() => Info.Country)" />
                    </label>
                </div>
            </div>
            <div class="form-section">
                <h2>Payment</h2>

                <div class="form-group">
                    <label class="payment-option">
                        <input type="radio"
                               name="payment-method"
                               value="Card"
                               checked="@(!IsPayPalSelected)"
                               @onchange="OnPaymentMethodChanged" />
                        <span>Credit card</span>
                    </label>
                    <label class="payment-option">
                        <input type="radio"
                               name="payment-method"
                               value="PayPal"
                               checked="@IsPayPalSelected"
                               @onchange="OnPaymentMethodChanged" />
                        <span>Pay with PayPal</span>
                    </label>
                </div>

                <InputHidden @bind-Value="Info.PaymentMethod" />
                <InputHidden @bind-Value="Info.PayPalOrderId" />

                @if (!IsPayPalSelected)
                {
                    <div class="form-buttons">
                        <a href="cart" class="button button-secondary">
                            <img role="presentation" src="icons/arrow-left.svg" />Back to the shopping bag
                        </a>
                        <button class="button button-primary" type="submit">Place order</button>
                    </div>
                }
                else
                {
                    <div class="form-buttons">
                        <a href="cart" class="button button-secondary">
                            <img role="presentation" src="icons/arrow-left.svg" />Back to the shopping bag
                        </a>
                    </div>
                    <div class="paypal-section">
                        <p>After you review your order, complete payment with your PayPal account.</p>
                        <div id="paypal-button-container"></div>
                    </div>
                }
            </div>
        </div>
        <ValidationSummary />
    </EditForm>
</div>

@code {
    private EditContext editContext = default!;
    private ValidationMessageStore extraMessages = default!;
    private string selectedPaymentMethod = "Card";
    private bool IsPayPalSelected => string.Equals(selectedPaymentMethod, "PayPal", StringComparison.OrdinalIgnoreCase);
    private IJSObjectReference? _paypalModule;
    private DotNetObjectReference<Checkout>? _dotNetRef;
    private bool _paypalButtonInitialized;

    [SupplyParameterFromForm]
    public BasketCheckoutInfo Info { get; set; } = default!;

    [CascadingParameter]
    public HttpContext HttpContext { get; set; } = default!;

    protected override void OnInitialized()
    {
        if (Info is null)
        {
            PopulateFormWithDefaultInfo();
        }

        var info = Info ?? throw new InvalidOperationException("Checkout info is not initialized.");

        selectedPaymentMethod = string.IsNullOrWhiteSpace(info.PaymentMethod)
            ? "Card"
            : info.PaymentMethod;

        info.PaymentMethod = selectedPaymentMethod;

        editContext = new EditContext(info);
        extraMessages = new ValidationMessageStore(editContext);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            _paypalModule = await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "./Components/Pages/Checkout/Checkout.razor.js");
        }

        if (IsPayPalSelected &&
            !_paypalButtonInitialized &&
            _paypalModule is not null &&
            _dotNetRef is not null)
        {
            _paypalButtonInitialized = true;

            var clientId = PayPalOptionsAccessor.Value.ClientId;
            if (!string.IsNullOrWhiteSpace(clientId))
            {
                await _paypalModule.InvokeVoidAsync(
                    "initializePayPalButton",
                    _dotNetRef,
                    "/api/paypal/order",
                    clientId);
            }
        }
    }

    private void PopulateFormWithDefaultInfo()
    {
        Info = new BasketCheckoutInfo
        {
            Street = ReadClaim("address_street"),
            City = ReadClaim("address_city"),
            State = ReadClaim("address_state"),
            Country = ReadClaim("address_country"),
            ZipCode = ReadClaim("address_zip_code"),
            RequestId = Guid.NewGuid()
        };

        string? ReadClaim(string type)
            => HttpContext.User.Claims.FirstOrDefault(x => x.Type == type)?.Value;
    }

    private async Task HandleSubmitAsync()
    {
        await PerformCustomValidationAsync();

        if (editContext.Validate())
        {
            await HandleValidSubmitAsync();
        }
    }

    private async Task HandleValidSubmitAsync()
    {
        // Default to the card-based flow unless the user explicitly chose PayPal.
        if (!string.Equals(Info.PaymentMethod, "PayPal", StringComparison.OrdinalIgnoreCase))
        {
            Info.PaymentMethod = "Card";
            Info.CardTypeId = 1;
        }

        await Basket.CheckoutAsync(Info);
        Nav.NavigateTo("user/orders");
    }

    private void OnPaymentMethodChanged(ChangeEventArgs e)
    {
        var selected = e.Value?.ToString();
        selectedPaymentMethod = string.Equals(selected, "PayPal", StringComparison.OrdinalIgnoreCase)
            ? "PayPal"
            : "Card";

        Info.PaymentMethod = selectedPaymentMethod;
        _paypalButtonInitialized = false;
    }

    private async Task PerformCustomValidationAsync()
    {
        extraMessages.Clear();

        if ((await Basket.GetBasketItemsAsync()).Count == 0)
        {
            extraMessages.Add(new FieldIdentifier(Info, ""), "Your cart is empty");
        }
    }

    private static DateTime? ParseExpiryDate(string? mmyy)
        => DateTime.TryParseExact($"01/{mmyy}", "dd/MM/yy", null, DateTimeStyles.None, out var result) ? result.ToUniversalTime() : null;

    [JSInvokable]
    public Task CompletePayPalCheckoutAsync(string paypalOrderId)
    {
        if (string.IsNullOrWhiteSpace(paypalOrderId))
        {
            return Task.CompletedTask;
        }

        return InvokeAsync(async () =>
        {
            Info.PaymentMethod = "PayPal";
            Info.PayPalOrderId = paypalOrderId;

            await PerformCustomValidationAsync();

            if (editContext.Validate())
            {
                await HandleValidSubmitAsync();
            }

            StateHasChanged();
        });
    }

    public async ValueTask DisposeAsync()
    {
        if (_paypalModule is not null)
        {
            await _paypalModule.DisposeAsync();
        }

        _dotNetRef?.Dispose();
    }
}
